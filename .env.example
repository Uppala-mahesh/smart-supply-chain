# Smart Supply Chain Management System - Environment Configuration
# 
# IMPORTANT: Copy this file to .env and update with your actual values
# Command: cp .env.example .env
#
# ⚠️  NEVER commit .env to version control - it contains secrets!

# ========== DATABASE CONFIGURATION ==========
# MySQL connection settings for the supply_chain database

# MySQL host (usually localhost)
DB_HOST=localhost

# MySQL username (default is 'root', but could be different)
DB_USER=root

# MySQL password (leave empty if no password set)
DB_PASSWORD=

# MySQL database name (must already exist)
DB_NAME=supply_chain

# ========== SECURITY CONFIGURATION ==========

# Secret key for signing JWT tokens (use a long random string)
# Generate with: openssl rand -base64 32
# Or just use any random string (for development)
JWT_SECRET=YourSecureRandomStringHere_Change_In_Production

# ========== SERVER CONFIGURATION ==========

# Backend server port (must be available)
# If port is in use, change to 5001, 5002, etc.
PORT=5000

# ========== FRONTEND CONFIGURATION ==========

# URL where the frontend can reach the backend API
# Keep as http://localhost:5000 during development
# Change to your server URL for production
VITE_API_BASE=http://localhost:5000

# ========== SETUP INSTRUCTIONS ==========
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Edit .env with your MySQL credentials:
#    - DB_HOST: Usually 'localhost' unless remote server
#    - DB_USER: MySQL username (usually 'root')
#    - DB_PASSWORD: MySQL password (leave empty if none)
#    - DB_NAME: Must match your database name ('supply_chain')
#
# 3. Verify database exists:
#    mysql -u root -p -e "SHOW DATABASES;"
#
# 4. Start the application:
#    npm run backend  (in terminal 1)
#    npm run dev      (in terminal 2)
#
# ========== TROUBLESHOOTING ==========
#
# Database connection fails?
#  - Check MySQL is running
#  - Verify DB_HOST, DB_USER, DB_PASSWORD are correct
#  - Ensure DB_NAME database exists
#
# Port already in use?
#  - Change PORT to 5001, 5002, etc.
#  - Update VITE_API_BASE to match new port
#
# See TROUBLESHOOTING.md for more help

